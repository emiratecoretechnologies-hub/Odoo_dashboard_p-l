<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_profit_loss_dashboard" model="report.paperformat">
            <field name="name">Profit Loss Dashboard Landscape</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">12</field>
            <field name="margin_bottom">12</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">8</field>
            <field name="dpi">96</field>
        </record>

        <record id="action_profit_loss_dashboard_pdf" model="ir.actions.report">
            <field name="name">Profit &amp; Loss Dashboard PDF</field>
            <field name="model">hc.profit.loss.dashboard.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hc_profit_loss_dashboard.pl_dashboard_pdf</field>
            <field name="report_file">hc_profit_loss_dashboard.pl_dashboard_pdf</field>
            <field name="binding_model_id" eval="False"/>
            <field name="paperformat_id" ref="paperformat_profit_loss_dashboard"/>
        </record>

        <record id="action_profit_loss_dashboard_xlsx" model="ir.actions.report">
            <field name="name">Profit &amp; Loss Dashboard XLSX</field>
            <field name="model">hc.profit.loss.dashboard.wizard</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">hc_profit_loss_dashboard.pl_dashboard_xlsx</field>
            <field name="report_file">hc_profit_loss_dashboard.pl_dashboard_xlsx</field>
            <field name="binding_model_id" eval="False"/>
        </record>
    </data>
</odoo>
